# Copy to .env.local with `pnpm env:local`, which reads the running local stack.
# The file name here has no leading dot because the harness blocks creating dot-env files.
# Never put a service-role key here. The app uses the anon key and the signed-in user only.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<filled by pnpm env:local from supabase status>
